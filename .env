# Copy this file to .env and adjust the values for your environment.
# Secrets must never be committed to version control.

# 128-bit or longer secret used to derive deterministic IDs.
# K_ds = HKDF-SHA256(JWT_HMAC_KEY, info="sid"), kid recorded separately.
# Recommended: openssl rand -base64 32
JWT_HMAC_KEY=upkuZ1ebOv8rj9Qv92+cFaxC5De8vJV8/Axk4csg+F8=

# Identifier for the dataset signing key (kid). Not secret but required for audits.
SID_KEY_ID=sid-fixture-202406

# Directory to store collected CSV log files.
LOG_DIR=./logs

# Rotation policy for CSV log files (daily or hourly).
CSV_ROTATION=daily

# Application timezone; keep UTC to align with data contracts.
APP_TIMEZONE=UTC

# GPU selection for trainer pipeline (ada6000 or 4060).
GPU_MODE=ada6000

# Node.js execution environment (default production).
NODE_ENV=production
