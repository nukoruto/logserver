# Server configuration
PORT=8000
REQUEST_LIMIT=2mb

# SQLite persistence
SQLITE_PATH=./data/db/events.sqlite3

# CSV export directory
CSV_ROOT=./data/raw

# Authentication
REQUIRE_AUTH=false
JWT_SECRET=change-me
JWT_AUDIENCE=
JWT_ISSUER=
JWT_HMAC_KEY=

# CORS origins (comma-separated). Leave empty to allow all origins.
CORS_ORIGINS=

# Pagination defaults
PAGE_LIMIT=100
PAGE_MAX_LIMIT=500
