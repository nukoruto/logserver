{
  "id": "defaultFlow",
  "description": "Normal session flow placeholder for future simulation refinements.",
  "states": ["start", "authenticated", "browsing", "editing", "completed"],
  "transitions": [
    { "from": "start", "to": "authenticated", "event": "login" },
