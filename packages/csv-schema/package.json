{
  "name": "@logserver/csv-schema",
  "version": "0.1.0",
  "description": "Streaming CSV parser with schema validation for log ingestion",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsup src/index.ts --dts --format esm,cjs --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
