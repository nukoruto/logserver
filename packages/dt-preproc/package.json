{
  "name": "@logserver/dt-preproc",
  "version": "0.1.0",
  "description": "Δt-aware preprocessing utilities for session log anomaly detection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dt-preproc": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsup src/index.ts src/cli.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logserver/csv-schema": "workspace:*",
    "csv-parse": "^5.5.6",
    "fast-csv": "^5.0.1",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/yargs": "^17.0.32",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5"
  }
}
