{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "noEmit": false,
    "types": ["node"]
    "baseUrl": "./src",
    "paths": {
      "@logserver/csv-schema": ["../../csv-schema/src/index.ts"],
      "@logserver/csv-schema/*": ["../../csv-schema/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
