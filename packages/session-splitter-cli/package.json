{
  "name": "@logserver/session-splitter-cli",
  "version": "0.1.0",
  "description": "CLI for session splitter library",
  "bin": {
    "session-splitter": "dist/cli.js",
    "split-sessions": "dist/bulk.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @logserver/session-splitter run build",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && pnpm run test:e2e",
    "test:e2e": "tsx --test __tests__/e2e/*.spec.ts"
  },
  "dependencies": {
    "@logserver/session-splitter": "workspace:*",
    "@resvg/resvg-js": "^2.6.1",
    "commander": "^12.1.0",
    "vega": "^5.28.0",
    "vega-lite": "^5.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
